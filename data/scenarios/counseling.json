      "beats_confidence_counseling": [
        {
          "goal": "이노스케가 멧돼지 가면을 쓴 채 난입한다. '자신감이 없다고?!'",
          "speaker_hint": ["inosuke"],
          "fx": "boar_charge"
        },
        {
          "goal": "이노스케: '크하하! 너는 이미 충분히 강하다! 자신을 믿어라!'",
