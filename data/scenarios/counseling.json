  "prologue_messages": [
    {
      "speaker": "narr",
      "text": "따뜻한 햇살이 비치는 조용한 거리. 한적한 골목에 위치한 '귀칼 상담소'라는 간판이 보입니다.",
      "emotion": "calm"
    },
    {
      "speaker": "narr",
      "text": "문을 열고 들어서자, 차분한 음악과 함께 따뜻한 차 향기가 당신을 맞이합니다.",
      "emotion": "welcoming"
    },
    {
      "speaker": "tanjiro",
      "text": "어서 오세요! 귀칼 상담소입니다. 편하게 앉으세요.",
      "emotion": "friendly"
    }
  ],
  "character_refs": {
    "tanjiro": "backend/data/characters/tanjiro.json",
    "zenitsu": "backend/data/characters/zenitsu.json",
    "inosuke": "backend/data/characters/inosuke.json",
    "nezuko": "backend/data/characters/nezuko.json",
    "rengoku": "backend/data/characters/rengoku.json",
    "giyu": "backend/data/characters/giyu.json",
    "shinobu": "backend/data/characters/shinobu.json"
  },
  "i18n": {
    "ko": {
      "beats_intro": [
        {
          "goal": "상담소 내부. 탄지로가 따뜻한 차를 내오며 {user}를 맞이한다.",
          "speaker_hint": ["tanjiro", "narr"],
          "fx": "tea_pour"
        },
        {
          "goal": "네즈코가 부엌에서 쿠키를 구워 내온다. 은은한 바닐라 향이 퍼진다.",
          "speaker_hint": ["nezuko", "narr"],
          "fx": "cookie_aroma"
        },
        {
          "goal": "탄지로가 {user}에게 무엇이든 편하게 이야기해도 괜찮다고 말한다.",
          "speaker_hint": ["tanjiro"],
          "fx": "gentle_smile"
        },
        {
          "goal": "{user}가 자신의 고민이나 일상을 이야기할 기회를 갖는다.",
          "speaker_hint": ["user_turn"],
          "fx": "peaceful_moment"
        }
      ],
      "beats_main_counseling": [
        {
          "goal": "탄지로가 {user}의 이야기를 진지하게 듣는다. 공감하며 고개를 끄덕인다.",
          "speaker_hint": ["tanjiro"],
          "fx": "empathy_nod"
        },
        {
          "goal": "상황에 따라 다른 상담원들이 등장할 수 있다. (젠이츠: 연애상담, 이노스케: 자신감, 렌고쿠: 목표, 기유: 인간관계, 시노부: 스트레스)",
          "speaker_hint": ["random_counselor"],
          "fx": "door_open"
        },
        {
          "goal": "상담원이 {user}의 상황에 맞는 조언과 위로를 건넨다.",
          "speaker_hint": ["active_counselor"],
          "fx": "warm_conversation"
        },
        {
          "goal": "{user}가 자신의 감정을 더 깊이 표현하거나, 질문을 할 수 있다.",
          "speaker_hint": ["user_turn"],
          "fx": "thoughtful_pause"
        }
      ],
      "beats_healing_activity": [
        {
          "goal": "상담원이 {user}에게 힐링 활동을 제안한다. (산책, 명상, 차 한 잔, 함께 요리, 운동 등)",
          "speaker_hint": ["active_counselor"],
          "fx": "activity_suggestion"
        },
        {
          "goal": "{user}가 제안받은 활동을 함께 하며 마음의 평온을 찾는다.",
          "speaker_hint": ["narr", "active_counselor"],
          "fx": "healing_moment"
        },
        {
          "goal": "활동 중 상담원과 더 깊은 대화를 나누거나, 새로운 깨달음을 얻는다.",
          "speaker_hint": ["user_turn", "active_counselor"],
          "fx": "peaceful_bgm"
        }
      ],
      "beats_group_support": [
        {
          "goal": "다른 상담원들도 하나둘씩 모여든다. 모두가 {user}를 응원한다.",
          "speaker_hint": ["tanjiro", "zenitsu", "inosuke"],
          "fx": "group_gathering"
        },
        {
          "goal": "각자의 방식으로 {user}를 격려한다. 젠이츠는 감동해서 울고, 이노스케는 힘차게 외친다.",
          "speaker_hint": ["zenitsu", "inosuke"],
          "fx": "emotional_support"
        },
        {
          "goal": "렌고쿠가 등장한다면 '우마이!'를 외치며 {user}의 고민 해결을 축하한다.",
          "speaker_hint": ["rengoku"],
          "fx": "umai_shout"
        }
      ],
      "beats_conclusion": [
        {
          "goal": "탄지로가 {user}에게 언제든 다시 찾아와도 좋다고 말한다.",
          "speaker_hint": ["tanjiro"],
          "fx": "gentle_farewell"
        },
        {
          "goal": "{user}가 상담소를 나서며 마음이 한결 가벼워진 것을 느낀다.",
          "speaker_hint": ["narr"],
          "fx": "peaceful_ending"
        },
        {
          "goal": "밖에서 따뜻한 햇살이 {user}를 비춘다. 새로운 하루를 맞이할 준비가 되었다.",
          "speaker_hint": ["narr"],
          "fx": "sunshine_warmth"
        }
      ]
    }
  },
  "stages": [
    {
