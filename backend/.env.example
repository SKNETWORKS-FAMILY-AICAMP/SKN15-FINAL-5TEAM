# KIME Chat Backend Environment Variables

# ============================================================
# OpenAI API Configuration
# ============================================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ============================================================
# Server Configuration
# ============================================================
HOST=0.0.0.0
PORT=8000

# ============================================================
# Development Mode
# ============================================================
DEBUG=True

# ============================================================
# Phase 3: Intent Detection LLM
# ============================================================
INTENT_LLM=1

# ============================================================
# Database Configuration
# ============================================================
# Local development (Docker PostgreSQL)
DATABASE_URL=postgresql://kime:dev123@localhost:5433/kimedb
LOGDB_URL=postgresql://kime:dev123@localhost:5433/kimedb

# Production (AWS RDS) - uncomment and update for production
# DATABASE_URL=postgresql://kime:your_password@your-rds-endpoint:5432/kimedb
# LOGDB_URL=postgresql://kime:your_password@your-rds-endpoint:5432/kimedb

# ============================================================
# Phase 4: Training Logger
# ============================================================
TRAINING_LOGGER_ENABLED=false  # Performance optimization: disabled during development

# ============================================================
# Phase 4.5: LLM-based Auto-labeling
# ============================================================
LLM_LABELING_ENABLED=false  # Performance optimization: removes additional LLM calls
LLM_LABELING_MODEL=gpt-4o-mini

# ============================================================
# Phase 4.6: A/B Testing (Optional)
# ============================================================
AB_TEST_ENABLED=false
AB_TEST_RATIO=0.1  # 10% hybrid evaluation

# ============================================================
# Performance Optimization: Entity Extraction & Embedding
# ============================================================
ENTITY_EXTRACTION_ENABLED=false  # Removes multiple embedding generations per request (major bottleneck!)

# ============================================================
# JWT Configuration
# ============================================================
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-please
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# Google OAuth 2.0 Configuration
# Get credentials from: https://console.cloud.google.com/apis/credentials
# ============================================================
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ============================================================
# Kakao OAuth Configuration
# Get credentials from: https://developers.kakao.com/console/app
# ============================================================
KAKAO_CLIENT_ID=your-kakao-app-key-here
KAKAO_REDIRECT_URI=http://localhost:8000/api/auth/kakao/callback

# ============================================================
# Email / SMTP Configuration (for password reset)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@kimechat.com
SMTP_FROM_NAME=KIME Chat

# ============================================================
# Frontend URL (for password reset links)
# ============================================================
FRONTEND_URL=http://localhost:5173
