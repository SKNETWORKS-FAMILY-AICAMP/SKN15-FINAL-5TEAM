{
  "scenario_id": "cutscene5_llm_driven",
  "module_id": "cutscene5_llm_driven",
  "title": "🔥 상현 삼 조우 — 코어 다이내믹 (5분)",
  "description": "갈림길→전략 개입(캐릭터 힌트)→동료 규합→보스 퇴장 시네마틱→판정→히든/기본 엔딩",
  "version": "5.3",
  "mountable": true,

  "character_refs": {
    "rengoku": "character_data/rengoku.json",
    "tanjiro": "character_data/tanjiro.json",
    "akaza": "character_data/akaza.json",
    "zenitsu": "character_data/zenitsu.json",
    "inosuke": "character_data/inosuke.json"
  },

  "orchestrator": {
    "mode": "llm",
    "turn_budget": 5,
    "allow_adlib_speakers": true,
    "policies": { "avoid_monologue": true, "no_triplicate": true, "keep_tension": true },
    "fallback_tiebreak": ["rengoku","tanjiro","user","akaza"]
  },

  "runtime": {
    "api_hints": {
      "minimize_calls": true,
      "batch_actions_per_turn": true,
      "reuse_context": true,
      "cache_i18n_lookups": true,
      "short_outputs": true
    },
    "print_policy": { "admin_logs": "compact", "user_logs": "minimal" }
  },

  "state_defaults": {
    "mentor_margin": 0,
    "battle_danger": 1,
    "time_left": 3,
    "allies_recruited": [],
    "pacing_flag": 3,
    "_forced_basic": false,
    "_outcome": null
  },

  "params": {
    "thresholds": { "hidden_min_margin": 2, "hidden_max_danger": 2, "time_min": 0 },
    "mission": { "max_turns": 10, "per_character_turn_cap": 3 }
  },

  "rules": {
    "design_intent": [
      "1) 분기 구조 고정",
      "2) 캐릭터 대사 유도, 시스템 최소",
      "3) 자유 입력 대화감",
      "4) 키워드 매칭 금지, LLM 의도판별",
      "5) 화자/순서 LLM 결정",
      "6) 재사용성/확장성",
      "7) 상태·룰 기반 판정",
      "8) 보상/해금 훅",
      "9) i18n/치환 용이",
      "10) 시간압박/실패 가능성",
      "11) 긴장 장면 멀티턴(≥4)",
      "12) 분기 힌트는 캐릭터 대사로 제시(시스템 선택지 금지)",
      "13) 보스 퇴장은 독립 시네마틱 스테이지"
    ],
    "tension_min_turns": 4,
    "cliff_guard": { "separate_turns_for": ["first_meet_boss","first_blood","fatal_blow"] }
  },

  "intent_inference": {
    "mode": "llm",
    "actions": [
      "choose_allies_path","choose_reckless_path",
      "intervene_attack","intervene_noise","intervene_ignore",
      "wake_zenitsu","convince_zenitsu","provoke_inosuke"
    ],
    "few_shots": [
      {
        "context": [
          {"speaker":"tanjiro","text":"{rengoku} 혼자서는 위험해… 난 움직이기 힘들어…"},
          {"speaker":"rengoku","text":"판단은 네게 맡기마."}
        ],
        "user_utterance": "젠이츠랑 이노스케 모아올게. 넌 엄호해.",
        "action": "choose_allies_path"
      },
      {
        "context": [
          {"speaker":"rengoku","text":"물러서라! 이 자는 내가 상대한다!"},
          {"speaker":"akaza","text":"하하, 더 와도 상관없지!"}
        ],
        "user_utterance": "지금 바로 뛰어들어 막을게!",
        "action": "choose_reckless_path"
      },
      {
        "context": [
          {"speaker":"tanjiro","text":"렌고쿠 씨… 위험해요! 저 공격은…"},
          {"speaker":"tanjiro","text":"{user}, 우리도 뭔가 도와야 해. 렌고쿠씨를 도와 멀리서 검기로 궤도를 비틀든지, 아니면 젠이츠/이노스케를 지금 데려오자. 어떻게 할까?"}
        ],
        "user_utterance": "원거리 견제로 궤도 비틀어줄게.",
        "action": "intervene_attack"
      },
      {
        "context": [
          {"speaker":"tanjiro","text":"렌고쿠 씨… 위험해요! 저 공격은…"},
          {"speaker":"tanjiro","text":"{user}, 돌 같은 걸로 소리만 내도 고개를 돌릴 거야. 아니면 동료를 찾자!"}
        ],
        "user_utterance": "돌 던져서 주의 끌자.",
        "action": "intervene_noise"
      },
      {
        "context": [
          {"speaker":"tanjiro","text":"렌고쿠 씨는 버틸 수 있어… 우리가 동료를 데려오면…"},
          {"speaker":"rengoku","text":"시간을 아껴라. 선택은 네 몫이다."}
        ],
        "user_utterance": "개입 안 하고 동료부터 찾자.",
        "action": "intervene_ignore"
      },
      {
        "context": [{"speaker":"zenitsu","text":"Zzz… 네즈코… Zzz…"}],
        "user_utterance": "젠이츠! 네즈코가 위험해!",
        "action": "wake_zenitsu"
      },
      {
        "context": [{"speaker":"zenitsu","text":"무서워… 나 못 해…!"}],
        "user_utterance": "지켜야 할 사람이 있잖아. 네 도움이 필요해.",
        "action": "convince_zenitsu"
      },
      {
        "context": [{"speaker":"inosuke","text":"여긴 산의 왕 이노스케님의 영역이다!"}],
        "user_utterance": "대장, 네가 앞장서라. 강한 놈이 필요한 때야.",
        "action": "provoke_inosuke"
      }
    ],
    "fallback": { "action": "intervene_ignore" }
  },

  "fx_lexicon": {
    "ground_fissure": "지면이 낮게 갈라지며 잔재가 흔들린다",
    "shadow_recoil": "보스의 그림자가 뒤로 말려들듯 후퇴한다",
