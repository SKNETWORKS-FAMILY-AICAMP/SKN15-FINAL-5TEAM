  "i18n": {
    "ko": {
      "beats_intro": [
        { "goal": "열차가 탈선하며 객차 안은 아비규환이다. 유리창이 깨지고 불꽃이 일렁인다. 먼지와 피 냄새가 뒤섞인다.", "speaker_hint": ["narr"], "fx": "brake_screech|ash_wind" },
        { "goal": "렌고쿠가 {user}를 발견하고 다가온다. '무사하군! 잘 버텼다, {user}, 탄지로!'", "speaker_hint": ["rengoku"], "fx": "flame_roar" },
        { "goal": "탄지로가 달려온다. '렌고쿠 님! 부상자들이 많아요!'", "speaker_hint": ["tanjiro","rengoku"] },
        { "goal": "엔무와의 싸움으로 부상을 당한 탄지로가 복부를 붙잡으며 비틀거린다. '으윽... 피가...'", "speaker_hint": ["tanjiro","rengoku"], "fx": "blood_spray|flame_ignition" },
        { "goal": "땅이 진동하며 먼지가 일어난다. '이건...' 렌고쿠의 표정이 굳는다.", "speaker_hint": ["narr","rengoku"], "fx": "ground_fissure|air_freeze" },
        { "goal": "먼지 속에서 한 그림자가 천천히 모습을 드러낸다. 상현 삼 아카자. '오… 염주인가.'", "speaker_hint": ["akaza"], "fx": "kanji_flash" },
        { "goal": "렌고쿠가 검을 뽑는다. '상현… 삼!'", "speaker_hint": ["rengoku"], "fx": "flame_ignition|pulse_boom" },
        { "goal": "탄지로가 외친다. '{user}! 렌고쿠 님이 위험해요!'", "speaker_hint": ["tanjiro"] },
        { "goal": "아카자가 돌진한다. 렌고쿠가 번개처럼 막아선다.", "speaker_hint": ["akaza","rengoku"], "fx": "blink_dash|blade_clash|shockwave_snap" },
        { "goal": "렌고쿠가 외친다. '물러서라, 둘 다!'", "speaker_hint": ["rengoku","narr"], "fx": "flame_roar" }
      ],

      "beats_route": [
        { "goal": "【전투 중】 아카자의 공격이 연이어 터진다. 땅이 갈라지고 먼지가 일어난다.", "speaker_hint": ["narr"], "fx": "ground_tremor|explosion" },
        { "goal": "탄지로가 숨을 몰아쉰다. '렌고쿠 님이… 혼자 버티고 있어요.'", "speaker_hint": ["tanjiro"] },
        { "goal": "렌고쿠의 외침이 들린다. '이 자리에서 물러서지 않겠다!'", "speaker_hint": ["rengoku"], "fx": "flame_ignition" },
        { "goal": "아카자가 웃는다. '하하, 더 와라! 모두 부숴주지!'", "speaker_hint": ["akaza"], "fx": "evil_laugh" },
        { "goal": "탄지로가 급히 말한다. '{user}! 어떻게 할까요?!'", "speaker_hint": ["tanjiro"], "fx": "urgent_heartbeat" },
        { "goal": "렌고쿠가 외친다. '판단은 너희에게 맡기마!'", "speaker_hint": ["rengoku"] },
        { "goal": "탄지로가 {user}를 본다. '두 가지 방법이 있어요. 동료를 찾거나, 지금 바로 렌고쿠씨와 함께 싸우던가.'", "speaker_hint": ["tanjiro"] },
        { "goal": "하늘에는 불길이 번지고, 결전의 시간이 다가온다.", "speaker_hint": ["narr"], "fx": "flame_flash" }
      ],

      "beats_intervene_hint": [
