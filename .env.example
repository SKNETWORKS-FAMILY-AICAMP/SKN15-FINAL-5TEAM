# ============================================================
# KIME Chat - 환경변수 설정 템플릿
# ============================================================
# 사용법:
#   1. 이 파일을 .env로 복사: cp .env.example .env
#   2. 아래 값들을 실제 값으로 수정
#   3. .env 파일은 절대 Git에 커밋하지 마세요!
# ============================================================

# ------------------------------------------------------------
# PostgreSQL 데이터베이스 설정
# ------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=kimedb
DB_USER=kime
DB_PASSWORD=your_secure_password_here

# ------------------------------------------------------------
# Redis 설정
# ------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ------------------------------------------------------------
# OpenAI API 설정 (필수)
# ------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here

# ------------------------------------------------------------
# JWT 인증 설정 (필수)
# ------------------------------------------------------------
JWT_SECRET_KEY=your-very-long-secret-key-for-jwt-min-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------
# OAuth 소셜 로그인 (선택)
# ------------------------------------------------------------
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/api/auth/kakao/callback

# ------------------------------------------------------------
# 이메일 설정 (비밀번호 재설정용, 선택)
# ------------------------------------------------------------
EMAIL_SENDER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ------------------------------------------------------------
# 애플리케이션 설정
# ------------------------------------------------------------
DEBUG=false
USE_LLM=true
FRONTEND_URL=http://localhost:80

# ------------------------------------------------------------
# Frontend 빌드 시 사용 (Vite)
# ------------------------------------------------------------
VITE_API_URL=http://localhost:8000
